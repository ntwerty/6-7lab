# ============================================
# Django Backend Settings
# ============================================

# Секретный ключ Django (ОБЯЗАТЕЛЬНО измените в продакшене!)
# Сгенерировать можно командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-generate-new-key

# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Разрешенные хосты (через запятую)
# Для продакшена укажите ваш домен
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================
# Database Settings (PostgreSQL)
# ============================================

# Имя базы данных
DB_NAME=game_db

# Пользователь базы данных
DB_USER=postgres

# Пароль базы данных
DB_PASSWORD=postgres

# Хост базы данных (для Docker используйте имя сервиса 'db', для локальной разработки 'localhost')
DB_HOST=db

# Порт базы данных
DB_PORT=5432

# ============================================
# Frontend Settings (опционально)
# ============================================

# URL бэкенд API для фронтенда
# Для Docker: http://localhost:8000/api
# Для локальной разработки: http://localhost:8000/api
REACT_APP_API_URL=http://localhost:8000/api

# ============================================
# Дополнительные настройки (опционально)
# ============================================

# Email настройки (если нужны уведомления)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password

# ============================================
# Инструкция по использованию
# ============================================
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Отредактируйте .env и укажите ваши настройки
# 3. НЕ коммитьте .env в Git (он уже в .gitignore)
# 4. Для продакшена ОБЯЗАТЕЛЬНО измените SECRET_KEY и установите DEBUG=False
